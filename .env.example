# ==========================================
# Yovexa Solutions Backend Environment Variables
# ==========================================

# Server Configuration
SERVER_PORT=8081

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DATABASE=yovexa_solutions

# JWT Authentication
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated for multiple origins)
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://yovexa-solutions-frontend.vercel.app/


# Email / Google SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
