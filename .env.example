# ===================================================================
# Yovexa Solutions Backend - Environment Variables Configuration
# ===================================================================
# Use this template for local .env or Vercel Environment Variables.
# IMPORTANT: Never commit production credentials, passwords, or secrets to Git.

# -------------------------------------------------------------------
# Server Port Configuration
# -------------------------------------------------------------------
# Local development default: 8081
# Vercel automatically injects $PORT in production.
PORT=8081
SERVER_PORT=8081

# -------------------------------------------------------------------
# MongoDB Atlas Database Configuration
# -------------------------------------------------------------------
# Example Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/yovexa_solutions?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://yovexa_admin:yovexa_solutions@cluster0.ydc4lh2.mongodb.net/yovexa_solutions?retryWrites=true&w=majority
MONGODB_DATABASE=yovexa_solutions

# -------------------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------------------
# 256-bit+ secure secret key for signing tokens
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long
# Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# CORS Allowed Origins
# -------------------------------------------------------------------
# Comma-separated list of origins permitted to call the backend.
# Do NOT use trailing slashes.
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://yovexa-solutions-frontend.vercel.app,https://yovexa-solutions-backend.vercel.app

# -------------------------------------------------------------------
# Mail / SMTP Configuration (Gmail SMTP)
# -------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
